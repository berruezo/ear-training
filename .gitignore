# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# User-data directory — contains password hashes / per-user settings
data/

# Local Claude Code settings
.claude/

# IDEs / editors
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Logs and temp files
*.log
*.tmp

# Credentials / secrets — defensive patterns. If any of these ever appear,
# something is wrong; never override these to commit a file.
.env
.env.*
*.env
secrets/
secrets.json
credentials.json
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
